tags: ['Recette oignon', 'Recette carotte', 'Recette vin', 'Recette champignon', 'Recette familiale', 'Recette bourguignonne', 'Recette lardon', 'Choix de la rédaction', 'Boeuf bourguignon', 'Recette toute l''année']
prepTime: 20
